{
    "name": "roundly-consulting/google-places-for-laravel",
    "description": "Query the Google Places API — place details, autocomplete, reverse geocoding, and distance matrix — from Laravel.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "google",
        "google-places",
        "places",
        "geocoding",
        "distance-matrix"
    ],
    "homepage": "https://github.com/roundly-consulting/google-places-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/enums-for-laravel": "@dev",
        "roundly-consulting/geolocation-for-laravel": "@dev",
        "roundly-consulting/http-client-rate-limits-for-laravel": "@dev",
        "roundly-consulting/package-toolkit-for-laravel": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../enums-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../geolocation-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../http-client-rate-limits-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../package-toolkit-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/enums-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/geolocation-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/http-client-rate-limits-for-laravel",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/package-toolkit-for-laravel",
            "no-api": true
        },
        {
            "type": "path",
            "url": "../testing-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/testing-for-laravel",
            "no-api": true
        }
    ],
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roundly-consulting/testing-for-laravel": "@dev"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\GooglePlaces\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\GooglePlaces\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\GooglePlaces\\GooglePlacesServiceProvider"
            ],
            "aliases": {
                "GooglePlaces": "RoundlyConsulting\\GooglePlaces\\Facades\\GooglePlaces"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
